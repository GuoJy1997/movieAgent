# Dependencies
node_modules/

# Build outputs
dist/
out/
coverage/
libtv-studio/apps/desktop/release/
libtv-studio/apps/desktop/release-*/

# Caches, test artifacts and tooling scratch
.cache/
.superpowers/
test-results/
playwright-report/
*.log

# Local environment and application configuration (may contain API credentials)
.env
.env.*
!.env.example
libtv-studio/config/

