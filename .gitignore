# Dependencies
node_modules/

# Build outputs
dist/
out/
coverage/
yangfan/apps/desktop/release/
yangfan/apps/desktop/release-*/

# Caches, test artifacts and tooling scratch
.cache/
.superpowers/
test-results/
playwright-report/
*.log

# Local environment and application configuration (may contain API credentials)
.env
.env.*
!.env.example
yangfan/config/

